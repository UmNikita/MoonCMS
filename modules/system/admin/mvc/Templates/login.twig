<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <main>
        <div id="login">
            <p>MoonCMS</p>
        </div>
        <div id="container">
            <div class="field">
                <p>Логин</p>
                <input>
            </div>
            <div class="field">
                <p>Пароль</p>
                <input>
            </div>
            <button>Войти</button>
        </div>
    </main>
    <style>
        * {
            margin: 0;
            padding: 0;
        }

        main {
            background-color: rgb(219, 219, 219);
            width: 100%;
            height: 75vh;
            padding-top: 25vh;
        }

        #container {
            margin-left: 42%;
            border: 1px solid #a8abac;
            border-radius: 5px;
            background-color: white;
            width: 350px;
            height: 275px;
        }

        #login {
            font-size: 50px;
            font-style: italic;
            text-align: center;
        }

        .field {
            margin-left: 25px;
        }

        .field p {
            font-size: 25px;
            color: rgb(50, 50, 50);
            margin-top: 15px;
        }
        .field input {
            height: 35px;
            width: 300px;
            margin-top: 10px;
        }
        button {
            height: 35px;
            width: 100px;
            background-color: #456b90;
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 5px;
            margin-top: 15px;
            margin-left: 25px;
        }
    </style>
</body>
</html>