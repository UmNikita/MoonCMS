<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <main>
        <div id="login">
            <p>MoonCMS</p>
        </div>
        <div id="container">
            <div class="field">
                <p>Почта</p>
                <input id="emailField">
            </div>
            <div class="field">
                <p>Пароль</p>
                <input id="pswField">
            </div>
            <p id="warning"></p>
            <button>Войти</button>
        </div>
    </main>
    <script>
        const btn = document.querySelector('button');
        const emailField = document.querySelector('#emailField');
        const pswField = document.querySelector('#pswField');
        const warning = document.querySelector('#warning');
        btn.addEventListener('click', (e) => {
            const email = emailField.value;
            const psw = pswField.value;
            warning.innerHTML = "";

            if(email.length == 0)
                emailField.style.border = "1px solid #8b2c2c";
            else
                emailField.style.border = "1px solid #3d3d3d";

            if(psw.length == 0)
                pswField.style.border = "1px solid #8b2c2c";
            else
                pswField.style.border = "1px solid #3d3d3d";

            if(psw.length == 0 || email.length == 0)
                return;

            fetch('/api/login', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    email: email,
                    password: psw
                })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success == true) {
                    window.location.replace("/moon-admin");
                }
                else {
                    warning.innerHTML = "Неверный логин или пароль";
                }
            })
            .catch(err => console.error(err));
        });
    </script>
    <style>
        * {
            margin: 0;
            padding: 0;
        }

        main {
            background-color: rgb(219, 219, 219);
            width: 100%;
            height: 75vh;
            padding-top: 25vh;
        }

        #container {
            margin-left: 42%;
            border: 1px solid #a8abac;
            border-radius: 5px;
            background-color: white;
            width: 350px;
            height: 275px;
        }

        #login {
            font-size: 50px;
            font-style: italic;
            text-align: center;
        }

        .field {
            margin-left: 25px;
        }

        .field p {
            font-size: 25px;
            color: rgb(50, 50, 50);
            margin-top: 15px;
        }
        .field input {
            height: 35px;
            width: 300px;
            margin-top: 10px;
        }
        #warning {
            margin-left: 25px;
            color: #8b2c2c;
        }
        button {
            height: 35px;
            width: 100px;
            background-color: #456b90;
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 5px;
            margin-top: 15px;
            margin-left: 25px;
        }
    </style>
</body>
</html>