<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <header>
        <div id="logo">
            <span>MoonCMS</span>
        </div>
        <div id="profile">
            <span id="profile-name">Никита Никитов</span>
            <span id="profile-exit">Выйти</span>
        </div>
    </header>
    <main>
        <section id="left-menu">
            <div class="menu-section">
                <div class="menu-el">
                    <p>Дашборд</p>
                </div>
                <div class="menu-el">
                    <p>Страницы</p>
                </div>
                <div class="menu-el">
                    <p>Контент</p>
                </div>
                <div class="menu-el">
                    <p>Файлы</p>
                </div>
                <div class="menu-el">
                    <p>Настройки</p>
                </div>
            </div>
            <div class="menu-section">
                <div class="menu-el">
                    <p>Товары</p>
                </div>
                <div class="menu-el">
                    <p>Аналитика</p>
                </div>
                <div class="menu-el">
                    <p>Маркетинг</p>
                </div>
                <div class="menu-el">
                    <p>Пользователи</p>
                </div>
                <div class="menu-el">
                    <p>Модули</p>
                </div>
            </div>
        </section>
        <section id="content">
            
        </section>
    </main>
    <style>
        * {
            margin: 0;
            padding: 0;
        }
        header {
            height: 5vh;
            width: 100%;
            background-color: #212121;
        }
        main {
            height: 95vh;
            display: flex;
        }
        #left-menu {
            height: 100%;
            width: 250px;
            background-color: #343434;
        }
        .menu-section {
            margin-top: 75px;
        }
        .menu-el {
            color: rgb(236, 236, 236);
            font-size: 25px;
            cursor: pointer;
            padding-top: 15px;
            padding-bottom: 15px;
            transition: 0.3s;
        }
        .menu-el p {
            margin-left: 15px;
        }
        .menu-el:hover {
            background-color: #456b90;
        }

        header {
            display: flex;
            justify-content: space-between;
        }
        #logo {
            color: white;
            margin-left: 25px;
            margin-top: 15px;
            font-size: 20px;
            cursor: pointer;
        }
        #profile {
            display: flex;
            margin-right: 25px;
            margin-top: 15px;
        }
        #profile-name {
            color: white;
            margin-right: 15px;
            cursor: pointer;
        }
        #profile-exit {
            color: rgb(200, 200, 200);
            cursor: pointer;
        }

        #content {
            background-color: rgb(219, 219, 219);
            width: 90%;
        }
    </style>
</body>
</html>